# Copy to .env.local and fill in. .env.local is gitignored.
#
# This app shares the LifeOS Supabase project. Its tables live in the
# `bakery` Postgres schema; LifeOS owns `public`. Same values as LifeOS's
# .env.local.

# --- Database -------------------------------------------------------------
# Both go through the SESSION pooler (port 5432), never transaction mode
# (6543) — postgres.js hangs on transaction mode under query depth. See
# C:\D\LifeOS\src\server\db\index.ts for the measurements.
DATABASE_URL=
DIRECT_URL=

# --- API ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Auth only; data goes through src/server.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-side only.
SUPABASE_SECRET_KEY=

# --- SePay (payments) -----------------------------------------------------
# my.sepay.vn. Webhook: URL https://<site>/api/sepay/webhook, auth HMAC-SHA256,
# content type JSON; paste its secret here. Payment code structure: prefix VB,
# 6 digits (Công ty -> Cấu hình chung -> Cấu trúc mã thanh toán).
SEPAY_WEBHOOK_SECRET=
# API token (Cài đặt công ty -> API Access) for the reconcile job.
SEPAY_API_TOKEN=
# Bank short name for the QR image (MBBank, Vietcombank, TPBank…).
SEPAY_BANK=
# Shown on the payment page, e.g. "MB Bank".
SEPAY_BANK_LABEL=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# Bearer secret for scheduled calls (/api/payments/reconcile).
CRON_SECRET=

# Who may open /quan-ly (comma separated Supabase account emails). Unset = nobody.
# The shop owner is anbuibz66@gmail.com; that account must exist in Supabase Auth.
OWNER_EMAILS=
